@namespace clase_4.Components

@for (int i = 0; i < 5; i++)
{
    int posicion = i;
    int n = i + 1;
    <div>
        <label for="">Digite la edad de la persona @n: </label>
        <input type="number" @bind="edades[posicion]">
        <label for="">Digite el peso de la persona @n: </label>
        <input type="number" @bind="pesos[posicion]">
    </div>
}
<button @onclick="calcular">Calcular</button>

@code {
    int[] edades = new int[5];
    double[] pesos = new double[5];
    double promedioNinos = 0;
    double promedioJovenes = 0;
    double promedioAdultos = 0;
    double promedioViejos = 0;

    void calcular()
    {
        int ninos = 0;
        int jovenes = 0;
        int adultos = 0;
        int viejos = 0;
        double pesoNinos = 0;
        double pesoJovenes = 0;
        double pesoAdultos = 0;
        double pesoViejos = 0;

        for (int i = 0; i < edades.Length; i++)
        {
            if (edades[i] <= 12)
            {
                ninos += 1;
                pesoNinos += pesos[i];
            }
            else if (edades[i] <= 29)
            {
                jovenes += 1;
                pesoJovenes += pesos[i];
            }
            else if (edades[i] <= 59)
            {
                adultos += 1;
                pesoAdultos += pesos[i];
            }
            else
            {
                viejos += 1;
                pesoViejos += pesos[i];
            }
        }

        // si no hay personas en una categoría, el promedio queda en 0 (evita dividir entre 0)
        promedioNinos = ninos > 0 ? pesoNinos / ninos : 0;
        promedioJovenes = jovenes > 0 ? pesoJovenes / jovenes : 0;
        promedioAdultos = adultos > 0 ? pesoAdultos / adultos : 0;
        promedioViejos = viejos > 0 ? pesoViejos / viejos : 0;
    }
}

<p>El promedio de peso de los niños es: @promedioNinos</p>
<p>El promedio de peso de los jóvenes es: @promedioJovenes</p>
<p>El promedio de peso de los adultos es: @promedioAdultos</p>
<p>El promedio de peso de los viejos es: @promedioViejos</p>
